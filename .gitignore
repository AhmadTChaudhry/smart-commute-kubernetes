# Dependency directories
# These are installed by 'npm install' and can be huge
node_modules/
api-service/node_modules/
processing-service/node_modules/
node-red/node_modules/

# Local data and log files
# This is generated by Node-RED when you run it locally and should not be in git
node-red-data/

# Build artifacts and downloaded packages
# This is a downloaded installer and does not belong in source control
AWSCLIV2.pkg

# IDE and OS-specific files
# Common files generated by macOS, VSCode, etc.
.DS_Store
.vscode/

# Environment files
# Never commit files containing secrets or environment-specific config
.env